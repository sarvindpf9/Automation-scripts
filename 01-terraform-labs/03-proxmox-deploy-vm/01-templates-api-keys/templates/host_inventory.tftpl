---
# Ansible Inventory - Auto-generated by Terraform
# Generated: ${timestamp}
# All hosts use Ubuntu user with SSH key authentication

all:
  children:
    proxmox_vms:
      description: "VMs deployed via Terraform on Proxmox"
      hosts:
%{ for vm_name, vm_data in vms ~}
        ${vm_name}:
          ansible_host: ${vm_data.primary_ip}
          ansible_user: ubuntu
          ansible_ssh_private_key_file: "~/.ssh/homelab-key"
          ansible_python_interpreter: /usr/bin/python3
%{ endfor ~}
      
      vars:
        ansible_become_method: sudo
        ansible_become_user: root
        
        # Global variables for all VMs
        ntp_timezone: UTC
        ntp_servers:
          - 0.ubuntu.pool.ntp.org
          - 1.ubuntu.pool.ntp.org
          - 2.ubuntu.pool.ntp.org
        
        dns_nameservers:
          - 1.1.1.1
          - 8.8.8.8
          - 8.8.4.4