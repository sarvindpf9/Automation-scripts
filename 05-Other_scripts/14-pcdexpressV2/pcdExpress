def capture_subprocess_output(func, *args, **kwargs):
    class LoggerWriter:
        def __init__(self, logger_func, prefix=""):
            self.logger_func = logger_func
            self.prefix = prefix
        def write(self, message):
            if message.strip():
                self.logger_func(f"{self.prefix}{message.strip()}")
        def flush(self):
            pass
    # Create logger writers
    stdout_logger = LoggerWriter(logger.info)
    stderr_logger = LoggerWriter(logger.error, "STDERR: ")
    # Backup original stdout/stderr
    original_stdout = sys.stdout
    original_stderr = sys.stderr
    try:
        class TeeWriter:
            def __init__(self, *writers):
                self.writers = writers

            def write(self, message):
                for writer in self.writers:
                    writer.write(message)

            def flush(self):
                for writer in self.writers:
                    if hasattr(writer, 'flush'):
                        writer.flush()

        sys.stdout = TeeWriter(original_stdout, stdout_logger)
        sys.stderr = TeeWriter(original_stderr, stderr_logger)

        # Execute the function
        result = func(*args, **kwargs)
        return result

    finally:
        # Restore original stdout/stderr
        sys.stdout = original_stdout
        sys.stderr = original_stderr

def run_ansible_logging(playbook_path, inventory_path, extra_vars):
    try:
        logger.info(f"Starting ansible playbook: {playbook_path}")
        logger.info(f"Using inventory: {inventory_path}")
        logger.info(f"Extra vars: {extra_vars}")
        result = capture_subprocess_output(
            pcdInstallHelper.run_ansible_playbook,
            playbook_path,
            inventory_path,
            extra_vars
        )
        if result:
            logger.info(f"Ansible playbook output: {result}")
        logger.info(
            f"Ansible playbook completed successfully: {playbook_path}")
        return result
    except Exception as e:
        logger.error(
            f"Ansible playbook failed: {playbook_path} - Error: {str(e)}")
        raise


