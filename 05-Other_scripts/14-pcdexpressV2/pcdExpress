    env_file_path = f"{current_dir}/{userInputDir}/{clustername}/{sitename}/{clustername}-{sitename}-{subsite}-environment.yaml"
    if os.path.exists(env_file_path):
        yaml_data = pcdInstallHelper.loadEnvFile(env_file_path)
        portal = yaml_data.get("portal"),
        region = yaml_data.get("region"),
        env = yaml_data.get("env"),
        logger.info(f"Using environment file: {env_file_path}")
        return portal, region, env
    else:
        error_msg = f"Error: Environment file {env_file_path} does not exist. Please create it before proceeding."
        logger.error(error_msg)
        print(error_msg)
        sys.exit(1)
        return None, None


