#cloud-config
{% set effective_cloud_init_user = vm_config.cloud_init_user | default(cloud_init_user) %}
hostname: {{ effective_vm_name | default(vm_config.vm_name) }}
manage_etc_hosts: true
users:
  - name: {{ effective_cloud_init_user }}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - {{ vm_ssh_public_key }}
chpasswd:
  list: |
    {{ effective_cloud_init_user }}:{{ cloud_init_user_password }}
  expire: false
package_update: false
write_files:
  - path: /usr/local/bin/pf9-render-netplan.sh
    owner: root:root
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail

      NETPLAN=/etc/netplan/50-cloud-init.yaml
      [ -f "${NETPLAN}" ] || exit 0

      IFACES=()
      for virtio_dev in $(ls /sys/bus/virtio/drivers/virtio_net/ 2>/dev/null | grep '^virtio[0-9]' | sort -V || true); do
        iface=$(ls "/sys/bus/virtio/drivers/virtio_net/${virtio_dev}/net" 2>/dev/null | sort -V | head -1)
        [ -n "${iface}" ] && IFACES+=("${iface}")
      done

      if [ -z "${IFACES[*]-}" ]; then
        mapfile -t IFACES < <(find /sys/class/net -mindepth 1 -maxdepth 1 -type l -exec basename {} \; | grep -Ev '^(lo|docker|br-|veth|virbr|tap)' | sort -V)
      fi

      export PF9_NETPLAN="${NETPLAN}"
      export PF9_IFACES="$(IFS=,; echo "${IFACES[*]}")"

      python3 - <<'PY'
      import os
      import re
      from pathlib import Path

      netplan_path = Path(os.environ["PF9_NETPLAN"])
      iface_names = [name for name in os.environ.get("PF9_IFACES", "").split(",") if name]

      mappings = []
      for index, iface_name in enumerate(iface_names):
          mac_path = Path("/sys/class/net") / iface_name / "address"
          mac_address = mac_path.read_text(encoding="utf-8").strip().lower()
          mappings.append((f"eth{index}", iface_name, mac_address))

      content = netplan_path.read_text(encoding="utf-8")
      for placeholder, iface_name, _mac_address in mappings:
          content = re.sub(
              rf"(?<![A-Za-z0-9_]){re.escape(placeholder)}(?![A-Za-z0-9_])",
              iface_name,
              content,
          )

      lines = content.splitlines()
      rendered = []
      in_ethernets = False
      known_ifaces = {iface_name: mac_address for _placeholder, iface_name, mac_address in mappings}

      index = 0
      while index < len(lines):
          line = lines[index]
          stripped = line.strip()

          if line == "ethernets:":
              in_ethernets = True
              rendered.append(line)
              index += 1
              continue

          if in_ethernets and line and not line.startswith(" "):
              in_ethernets = False

          ethernet_match = re.match(r"^  ([A-Za-z0-9_.:-]+):$", line)
          if in_ethernets and ethernet_match:
              iface_name = ethernet_match.group(1)
              rendered.append(line)

              next_index = index + 1
              stanza = []
              while next_index < len(lines):
                  next_line = lines[next_index]
                  if next_line and not next_line.startswith(" "):
                      break
                  if re.match(r"^  [A-Za-z0-9_.:-]+:$", next_line):
                      break
                  stanza.append(next_line)
                  next_index += 1

              has_match = any(entry.strip() == "match:" for entry in stanza)
              if iface_name in known_ifaces and not has_match:
                  rendered.append("    match:")
                  rendered.append(f"      macaddress: \"{known_ifaces[iface_name]}\"")

              rendered.extend(stanza)
              index = next_index
              continue

          rendered.append(line)
          index += 1

      netplan_path.write_text("\n".join(rendered) + "\n", encoding="utf-8")
      PY

      chmod 600 "${NETPLAN}"
      netplan generate
      netplan apply
runcmd:
  - /usr/local/bin/pf9-render-netplan.sh
